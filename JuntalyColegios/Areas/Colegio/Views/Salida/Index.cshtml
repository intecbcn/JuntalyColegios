@model JuntalyColegios.Application.DTOs.PantallaSalidaDto
@{
    ViewData["Title"] = "Pantalla de salida";
}

<a asp-controller="Inicio" asp-action="Index" class="btn btn-link px-0">&larr; Mi colegio</a>
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Salida · @Model.NombreColegio</h1>
    <span class="text-muted small">Se actualiza automáticamente</span>
</div>
<partial name="_Avisos" />
@if (TempData["Simulacion"] is string simulacion)
{
    <div class="alert alert-info" role="alert">@simulacion</div>
}

<div id="pendientes" data-url="@Url.Action("Pendientes")">
    <partial name="_Pendientes" model="Model" />
</div>

<section class="mt-5 border-top pt-3">
    <h2 class="h6">Simulador de llegada (demostración)</h2>
    @if (Model.VehiculosParaSimular.Count == 0)
    {
        <p class="text-muted mt-2">No hay vehículos con tag RFID asignado.</p>
    }
    else
    {
        <form asp-action="Simular" method="post" class="row g-2 align-items-end mt-2" style="max-width: 640px">
            <div class="col">
                <label for="vehiculoId" class="form-label">Vehículo</label>
                <select id="vehiculoId" name="vehiculoId" class="form-select">
                    @foreach (var vehiculo in Model.VehiculosParaSimular)
                    {
                        <option value="@vehiculo.Id">@vehiculo.Placa · @vehiculo.Representante</option>
                    }
                </select>
            </div>
            <div class="col-auto"><button type="submit" class="btn btn-outline-primary">Simular llegada</button></div>
        </form>
    }
</section>

@section Scripts {
    <script src="~/js/salida.js" asp-append-version="true"></script>
}
