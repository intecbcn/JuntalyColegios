@model JuntalyColegios.Application.DTOs.FranjasDelColegioDto
@using JuntalyColegios.Application.Formato
@{
    ViewData["Title"] = "Franjas de retiro";
    var ahora = Model.HoraLocalActual;
}

<a asp-controller="Inicio" asp-action="Index" class="btn btn-link px-0">&larr; Mi colegio</a>
<h1>Franjas de retiro</h1>
<p class="text-muted">
    Solo dentro de una franja se llama a los alumnos cuando la antena detecta un vehículo: fuera de horario un tag
    en la zona no genera llamadas. Si una clase tiene franjas propias un día, ese día se usan las suyas en lugar de las
    del colegio.
</p>
<partial name="_Avisos" />

<div class="alert @(Model.ColegioEnFranjaAhora ? "alert-success" : "alert-secondary")">
    Hora del colegio (@Model.ZonaHoraria): <strong>@DiasSemana.Nombre(ahora.DayOfWeek) @ahora.ToString("HH:mm")</strong> —
    @(Model.ColegioEnFranjaAhora ? "Ahora se llama a los alumnos." : "Ahora no hay franja general de retiro.")
</div>

@if (Model.Franjas.Count == 0)
{
    <div class="alert alert-warning">
        Todavía no hay franjas: <strong>no se llamará a ningún alumno</strong> aunque se detecte su vehículo.
    </div>
}
else
{
    <div class="table-responsive jc-table-wrap">
    <table class="table align-middle">
        <thead><tr><th>Día</th><th>Horario</th><th>Aplica a</th><th></th></tr></thead>
        <tbody>
            @foreach (var franja in Model.Franjas)
            {
                <tr>
                    <td>@DiasSemana.Nombre(franja.DiaSemana)</td>
                    <td>@franja.HoraInicio.ToString("HH:mm") – @franja.HoraFin.ToString("HH:mm")</td>
                    <td>@franja.Ambito</td>
                    <td class="text-end">
                        <form asp-action="Eliminar" asp-route-id="@franja.Id" method="post">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

<h2 class="h5 mt-4">Añadir franja</h2>
<form asp-action="Crear" method="post" class="row g-3" style="max-width: 900px">
    <div class="col-md-4">
        <label for="ClaseId" class="form-label">Aplica a</label>
        <select id="ClaseId" name="ClaseId" class="form-select">
            <option value="">Todo el colegio</option>
            @foreach (var clase in Model.Clases)
            {
                <option value="@clase.Id">@clase.Nombre</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <label for="HoraInicio" class="form-label">Desde</label>
        <input id="HoraInicio" name="HoraInicio" type="time" class="form-control" required />
    </div>
    <div class="col-md-4">
        <label for="HoraFin" class="form-label">Hasta</label>
        <input id="HoraFin" name="HoraFin" type="time" class="form-control" required />
    </div>
    <fieldset class="col-12">
        <legend class="form-label fs-6">Días</legend>
        @foreach (var dia in DiasSemana.DeLunesADomingo)
        {
            var id = $"dia-{dia}";
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="checkbox" name="Dias" value="@dia" id="@id" />
                <label class="form-check-label" for="@id">@DiasSemana.Nombre(dia)</label>
            </div>
        }
    </fieldset>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Añadir franja</button>
    </div>
</form>
