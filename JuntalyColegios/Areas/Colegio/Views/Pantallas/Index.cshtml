@model JuntalyColegios.Application.DTOs.PantallasDelColegioDto
@{
    ViewData["Title"] = "Pantallas de llamada";
}

<a asp-controller="Inicio" asp-action="Index" class="btn btn-link px-0">&larr; Mi colegio</a>
<h1>Pantallas de llamada</h1>
<p class="text-muted">
    Pantallas estilo turnero para una TV en la portería o una tablet en cada aula. Se abren con su enlace, sin
    iniciar sesión, y solo muestran el nombre, la clase y la placa de los alumnos llamados. Trata el enlace como
    una contraseña: si se comparte por error, regéneralo o revoca la pantalla.
</p>
<partial name="_Avisos" />

@if (TempData["EnlacePantalla"] is string enlace)
{
    <div class="alert alert-warning" role="alert">
        Enlace de la pantalla (cópialo y ábrelo en la TV o tablet; no se volverá a mostrar):<br />
        <code id="enlace-pantalla" class="fs-6 user-select-all text-break">@enlace</code>
    </div>
}

@if (Model.Pantallas.Count == 0)
{
    <p class="text-muted">Todavía no hay pantallas.</p>
}
else
{
    <div class="table-responsive jc-table-wrap">
        <table class="table align-middle">
            <thead><tr><th>Pantalla</th><th></th></tr></thead>
            <tbody>
                @foreach (var pantalla in Model.Pantallas)
                {
                    <tr>
                        <td>@pantalla.Nombre</td>
                        <td class="text-end">
                            <div class="jc-actions justify-content-end">
                                <form asp-action="Crear" method="post">
                                    <input type="hidden" name="claseId" value="@pantalla.ClaseId" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary">Nuevo enlace</button>
                                </form>
                                <form asp-action="Revocar" asp-route-id="@pantalla.Id" method="post">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Revocar</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h2 class="h5 mt-4">Crear pantalla</h2>
<form asp-action="Crear" method="post" class="row g-2 align-items-end" style="max-width: 640px">
    <div class="col">
        <label for="claseId" class="form-label">Para</label>
        <select id="claseId" name="claseId" class="form-select">
            <option value="">Portería (todos los alumnos)</option>
            @foreach (var clase in Model.Clases)
            {
                <option value="@clase.Id">Aula @clase.Nombre</option>
            }
        </select>
    </div>
    <div class="col-auto"><button type="submit" class="btn btn-primary">Crear y ver enlace</button></div>
</form>
