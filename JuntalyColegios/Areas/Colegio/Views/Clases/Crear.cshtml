@model JuntalyColegios.Areas.ColegioSupervisor.Models.ClaseFormulario
@{
    ViewData["Title"] = "Nueva clase";
}

<h1>Nueva clase</h1>
<div class="row">
    <div class="col-md-6">
        <form asp-action="Crear" method="post">
            <partial name="_FormularioClase" model="Model" />
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-controller="Inicio" asp-action="Index" class="btn btn-link">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
