@model JuntalyColegios.Areas.ColegioSupervisor.Models.ClaseFormulario
@{
    ViewData["Title"] = "Editar clase";
    var id = (Guid)ViewData["ClaseId"]!;
}

<h1>Editar clase</h1>
<div class="row">
    <div class="col-md-6">
        <form asp-action="Editar" asp-route-id="@id" method="post">
            <partial name="_FormularioClase" model="Model" />
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-action="Detalle" asp-route-id="@id" class="btn btn-link">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
