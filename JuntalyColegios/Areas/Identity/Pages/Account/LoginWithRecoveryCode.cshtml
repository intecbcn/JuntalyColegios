@page
@model LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "Verificación con código de recuperación";
}

<h1>@ViewData["Title"]</h1>
<hr />
<p>
    Solicitaste iniciar sesión con un código de recuperación. Este inicio de sesión no se recordará hasta que
    proporciones un código de tu app autenticadora al iniciar sesión, o desactives la autenticación en dos pasos.
</p>
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.RecoveryCode" class="form-control" autocomplete="off" placeholder="Código de recuperación" />
                <label asp-for="Input.RecoveryCode" class="form-label">Código de recuperación</label>
                <span asp-validation-for="Input.RecoveryCode" class="text-danger"></span>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Iniciar sesión</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}