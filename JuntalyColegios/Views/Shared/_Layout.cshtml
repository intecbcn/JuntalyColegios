<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Juntaly Colegios</title>
    <link rel="icon" href="~/images/logo-juntaly.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;700;800&family=Nunito:wght@600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/JuntalyColegios.styles.css" asp-append-version="true" />
</head>
<body class="jc-body jc-app-body">

<header class="jc-app-header">
    <div class="jc-app-header-bar">
        <a href="/" class="jc-app-brand">
            <img src="~/images/logo-juntaly.png" alt="Juntaly" />
            <span class="jc-app-brand-text">
                <span class="jc-app-brand-name">Juntaly</span>
                <span class="jc-app-brand-badge">Colegios</span>
            </span>
        </a>
        <button class="jc-nav-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#jcAppNav"
                aria-controls="jcAppNav" aria-expanded="false" aria-label="Abrir menú">
            <span></span><span></span><span></span>
        </button>
        <nav id="jcAppNav" class="jc-app-nav collapse">
            <partial name="_LoginPartial" />
        </nav>
    </div>
</header>

<main role="main" class="jc-app-main">
    @RenderBody()
</main>

<footer class="jc-app-footer">
    <span>© @DateTime.Now.Year Juntaly Colegios · by Intec</span>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
