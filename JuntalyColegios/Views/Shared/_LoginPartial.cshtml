@using JuntalyColegios.Application.Seguridad
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

<ul class="jc-app-menu">
@if (SignInManager.IsSignedIn(User))
{
    @if (User.IsInRole(Roles.AdminApp))
    {
        <li><a class="jc-navlink" href="/Admin">Administración</a></li>
    }
    @if (User.IsInRole(Roles.SupervisorColegio))
    {
        <li><a class="jc-navlink" href="/Colegio">Mi colegio</a></li>
    }
    @if (User.IsInRole(Roles.Padre))
    {
        <li><a class="jc-navlink" href="/Padres">Mi familia</a></li>
    }
    <li>
        <a class="jc-navlink jc-app-cuenta" asp-area="Identity" asp-page="/Account/Manage/Index" title="Mi cuenta">Hola, @User.Identity?.Name</a>
    </li>
    <li>
        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="jc-btn jc-btn-cta jc-app-salir">Cerrar sesión</button>
        </form>
    </li>
}
else
{
    <li><a class="jc-btn jc-btn-cta" asp-area="Identity" asp-page="/Account/Login">Iniciar sesión</a></li>
}
</ul>
