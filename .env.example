# Configuración local. Copiar este archivo a ".env" y completar. ".env" NO se commitea (ver .gitignore).
# Las mismas variables sirven en un servidor (como variables de entorno o un .env junto a la aplicación).

# Base de datos PostgreSQL (obligatoria). Ejemplo con un PostgreSQL local:
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=juntaly_colegios;Username=postgres;Password=TU_CONTRASENA

# Administrador de la plataforma (rol AdminApp). Se crea al arrancar si no existe.
AdminInicial__Email=admin@ejemplo.com
AdminInicial__Password=Admin123!

# Datos de demostración: colegio de demo con las cuentas de prueba supervisor@demo.juntaly.com y
# padre@demo.juntaly.com, ambas con la contraseña indicada. Se crean al arrancar si no existen.
Demo__Sembrar=true
Demo__Contrasena=Demo123!
# Opcional: clave de la antena del colegio de demo, para probar POST /api/antena/detecciones.
Demo__ClaveAntena=clave-antena-demo-local

# Email (opcional en local: sin SMTP, en Development los emails se escriben en la consola).
# Smtp__Host=smtp.ejemplo.com
# Smtp__Port=587
# Smtp__User=usuario
# Smtp__Password=contrasena
# Smtp__From=no-reply@ejemplo.com

# Solo en un servidor: dominio público de la app (para validar el Host y construir los enlaces de los emails).
# AllowedHosts=tu-dominio.com
# App__UrlBase=https://tu-dominio.com

# Límite de lecturas por minuto de cada antena en la API (por defecto 120).
# Antena__PeticionesPorMinuto=120
