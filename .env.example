# Credenciales de Supabase (PostgreSQL) para desarrollo local.
# Copiar este archivo a ".env" y completar con los valores reales del proyecto en Supabase
# (Project Settings > Database > Connection string / Connection pooling).
# ".env" NO se commitea (ver .gitignore).

ConnectionStrings__DefaultConnection=Host=YOUR_PROJECT_REF.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=YOUR_DB_PASSWORD;SSL Mode=Require;Trust Server Certificate=true

# Administrador inicial de la plataforma (rol AdminApp). Se crea al arrancar si no existe.
# Si no se definen, solo se crean los roles. Usar una contraseña robusta y no reutilizarla.
AdminInicial__Email=admin@tu-dominio.com
AdminInicial__Password=CAMBIAR_POR_UNA_CONTRASENA_ROBUSTA
